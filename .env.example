# Copy to .env.local for development. Set the same values in Vercel. Never commit real values.

# Public URL of the site (used for canonical URLs, sitemap and Open Graph).
# Optional on Vercel: production uses the project's production domain and previews use their own URL.
# If you set it in Vercel, scope it to Production only, or previews will point at it too.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Waitlist storage (server only). Run supabase/migrations/*_waitlist.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional confirmation email via Resend. Leave blank to skip.
RESEND_API_KEY=
RESEND_FROM="Career OS <hello@yourdomain.com>"

# Optional. Links only render when set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CAL_WASIF_URL=
NEXT_PUBLIC_CAL_ABISHEK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_REDDIT_URL=
